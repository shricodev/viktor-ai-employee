NODE_ENV=development
LOG_LEVEL=info

# Public HTTPS URL that Slack and Composio can reach (ngrok / cloudflared in dev)
PUBLIC_URL=https://viktor.example.com
PORT=3000

DATABASE_URL=postgres://viktor:viktor@localhost:5432/viktor
REDIS_URL=redis://localhost:6379
# openssl rand -hex 32
ENCRYPTION_KEY=

# api.slack.com/apps -> Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# any random string, used to sign the OAuth state
SLACK_STATE_SECRET=

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5

# platform.composio.dev -> Settings
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=

SANDBOX_IMAGE=viktor-sandbox:latest

# Optional: enables semantic memory search (falls back to full-text search)
VOYAGE_API_KEY=
