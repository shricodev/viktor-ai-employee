NODE_ENV=development
LOG_LEVEL=info

# Public HTTPS URL that Slack and Composio can reach (cloudflared / ngrok in development)
PUBLIC_URL=https://viktor.example.com
PORT=3000

DATABASE_URL=postgres://viktor:viktor@localhost:5432/viktor
REDIS_URL=redis://localhost:6379
# openssl rand -hex 32
ENCRYPTION_KEY=

# api.slack.com/apps -> Basic Information. Only the gateway needs these; `pnpm chat` runs without them.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Any random string of 16+ characters, used to sign the OAuth state
SLACK_STATE_SECRET=

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5
AGENT_EFFORT=high
AGENT_MAX_TURNS=40
# Hard cap on what a single task may spend
AGENT_MAX_RUN_USD=5
AGENT_TIMEOUT_MS=1800000
APPROVAL_TIMEOUT_MS=900000
# Applies to workspaces without their own budget; 0 disables the limit
DEFAULT_MONTHLY_BUDGET_USD=100

# platform.composio.dev -> Settings -> API keys
COMPOSIO_API_KEY=
# Printed by `pnpm --filter @viktor/gateway register-webhook`
COMPOSIO_WEBHOOK_SECRET=

SANDBOX_IMAGE=viktor-sandbox:latest
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=1
SANDBOX_NETWORK=bridge
SANDBOX_IDLE_MINUTES=30

PROACTIVE_ENABLED=true

# Optional: enables semantic memory search (full-text search is always on)
VOYAGE_API_KEY=
